# ============================================================================
# AIbooking Restaurant – environment variables
# Kopiér til .env.local (lokalt) eller sæt i Vercel → Project → Settings → Environment Variables.
# ALDRIG commit rigtige nøgler. Kun NEXT_PUBLIC_* sendes til browseren.
# ============================================================================

# --- Offentlig (browser) -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://restaurant.aibooking.dk
# AIbooking Voice/Chat-widget. Tom = indbygget demo-receptionist (chat + voice i browseren).
# *.js => indlæses som script. Anden URL => vises som iframe.
NEXT_PUBLIC_AIBOOKING_WIDGET_URL=
# Standard agent-id (kan overstyres pr. restaurant i admin → AI-assistent / tabellen ai_agents)
NEXT_PUBLIC_AIBOOKING_AGENT_ID=
# Valgfri central AIbooking-API. Tom = denne apps egne /api-ruter.
NEXT_PUBLIC_AIBOOKING_API_URL=

# --- Platform ------------------------------------------------------------------
# true = offentlig salgsdemo (ingen login til /admin). Sæt false i produktion.
DEMO_MODE=true
DEFAULT_RESTAURANT_SLUG=bella-napoli
# Telefonnummer til "Ring til demoen" (AI-telefonlinjen). Tom = pladsholder.
AIBOOKING_DEMO_PHONE=

# --- Admin (kun når DEMO_MODE=false) ------------------------------------------------
ADMIN_PASSWORD=
# Lang tilfældig streng, fx: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Bearer-nøgle til server-til-server kald (POS, scripts): Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# --- AIbooking Voice / webhooks --------------------------------------------------
# Nøgle som AIbooking Voice bruger mod POST /api/orders, /api/calls og /api/webhooks
AIBOOKING_API_KEY=
# HMAC-secret til X-AIbooking-Signature på indgående webhooks
AIBOOKING_WEBHOOK_SECRET=

# --- Supabase (tom = in-memory demo-lager) ----------------------------------------
SUPABASE_URL=
# Kun server-side! Må aldrig have NEXT_PUBLIC_-præfiks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (tom = simuleret betaling i demo) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Shopify (valgfri) -----------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_WEBHOOK_SECRET=

# --- Custom API / POS (valgfri) -----------------------------------------------------
CUSTOM_ORDER_WEBHOOK_URL=
CUSTOM_WEBHOOK_SECRET=

# --- Booking-system (valgfri) ------------------------------------------------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
BOOKING_WEBHOOK_URL=

# --- Leads fra "Book demo" (valgfri, fx Slack/CRM-webhook) -------------------------------
LEADS_WEBHOOK_URL=
